---
import BaseLayout from '../../layouts/BaseLayout.astro';

const demos = import.meta.glob('../../components/demos/*.svelte');
const names = Object.keys(demos)
  .map((p) => p.split('/').pop()!.replace('.svelte', ''))
  .sort();
---

<BaseLayout title="Sandbox" description="Demo component sandbox">
  <main class="sandbox">
    <header>
      <p class="kicker">Sandbox</p>
      <h1>Demo components</h1>
      <p class="hint">
        Drop a <code>.svelte</code> file into <code>src/components/demos/</code> and it appears here.
      </p>
    </header>

    <ul class="demo-list">
      {names.map((name) => (
        <li>
          <a href={`/sandbox/${name}`}>{name}</a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<style>
  .sandbox {
    color: var(--text);
    margin: 0 auto;
    max-width: 720px;
    padding: 3em 2em;
  }

  .kicker {
    color: var(--accent);
    font-size: 0.8em;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin: 0 0 0.5em;
    text-transform: uppercase;
  }

  h1 {
    font-size: 2em;
    margin: 0 0 0.5em;
  }

  .hint {
    color: var(--text-muted);
    margin: 0 0 2em;
    opacity: 0.8;
  }

  code {
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border-radius: var(--radius);
    color: var(--accent);
    font-size: 0.9em;
    padding: 0.1em 0.4em;
  }

  .demo-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .demo-list li {
    border-bottom: 1px solid var(--border);
  }

  .demo-list a {
    color: var(--text);
    display: block;
    font-weight: 700;
    padding: 1em 0;
    text-decoration: none;
    transition: color var(--transition), padding-left var(--transition);
  }

  .demo-list a:hover {
    color: var(--accent);
    padding-left: 0.5em;
  }
</style>
