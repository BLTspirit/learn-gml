---
import { getCollection, render } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';

export async function getStaticPaths() {
  const allLessons = await getCollection('lessons');
  const lessons = allLessons
    .filter(l => !l.data.draft)
    .sort((a, b) => a.data.chapter - b.data.chapter || a.data.lesson - b.data.lesson);

  return lessons.map((lesson, i) => ({
    params: { slug: lesson.id },
    props: {
      lesson,
      prevLesson: lessons[i - 1] ?? null,
      nextLesson: lessons[i + 1] ?? null,
    },
  }));
}

const { lesson, prevLesson, nextLesson } = Astro.props;
const { Content, headings } = await render(lesson);
---

<LessonLayout
  title={lesson.data.title}
  description={lesson.data.description}
  currentLessonId={lesson.id}
>
  <header>
    <p class="chapter-label">Chapter {lesson.data.chapter}, Lesson {lesson.data.lesson}</p>
    <h1>{lesson.data.title}</h1>
  </header>

  {headings.length > 0 && (
    <nav aria-label="On this page">
      <strong>On this page</strong>
      <ul>
        {headings.map(heading => (
          <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
        ))}
      </ul>
    </nav>
  )}

  <article>
    <Content />
  </article>

  <div class="lesson-footer">
    <div class="lesson-nav">
      {prevLesson
        ? <a href={`/lessons/${prevLesson.id}`} class="nav-btn" aria-label={`Previous: ${prevLesson.data.title}`}>←</a>
        : <span class="nav-btn-placeholder" />
      }

      <button
        id="complete-btn"
        class="complete-btn"
        data-lesson-id={lesson.id}
        data-lesson-title={lesson.data.title}
      >
        <span class="label-incomplete">Mark as complete</span>
        <span class="label-complete">Mark as incomplete</span>
      </button>

      {nextLesson
        ? <a href={`/lessons/${nextLesson.id}`} class="nav-btn" aria-label={`Next: ${nextLesson.data.title}`}>→</a>
        : <span class="nav-btn-placeholder" />
      }
    </div>
  </div>
</LessonLayout>

<script>
  const btn = document.getElementById('complete-btn') as HTMLButtonElement | null;

  if (btn) {
    const lessonId = btn.dataset.lessonId!;
    const lessonTitle = btn.dataset.lessonTitle!;

    // Track last visited
    if (localStorage.getItem('trackProgress') !== 'false') {
      localStorage.setItem('lastLesson', JSON.stringify({ id: lessonId, title: lessonTitle }));
    }

    // Restore completion state before revealing button to avoid label-width jump
    if (localStorage.getItem(`completed:${lessonId}`) === 'true') {
      btn.dataset.complete = 'true';
    }
    btn.classList.add('ready');

    btn.addEventListener('click', () => {
      const nowComplete = btn.dataset.complete !== 'true';
      if (nowComplete) {
        localStorage.setItem(`completed:${lessonId}`, 'true');
        btn.dataset.complete = 'true';
      } else {
        localStorage.removeItem(`completed:${lessonId}`);
        delete btn.dataset.complete;
      }
      window.dispatchEvent(
        new CustomEvent('lesson-completed', { detail: { id: lessonId, complete: nowComplete } })
      );
    });
  }
</script>

<style>
  header {
    margin-bottom: 2em;
  }

  .chapter-label {
    color: var(--accent);
    font-size: 0.8em;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin: 0 0 0.5em;
    text-transform: uppercase;
  }

  h1 {
    font-size: 2em;
    font-weight: 700;
    margin: 0;
  }

  nav {
    border-left: 3px solid var(--accent);
    margin-bottom: 2.5em;
    padding: 0.75em 1.25em;
  }

  nav strong {
    display: block;
    font-size: 0.8em;
    letter-spacing: 0.1em;
    margin-bottom: 0.5em;
    opacity: 0.7;
    text-transform: uppercase;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--text-muted);
    font-size: 0.9em;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent);
  }

  article {
    line-height: 1.7;
  }

  /* Footer nav */
  .lesson-footer {
    border-top: 1px solid var(--border);
    margin-top: 3em;
    padding-top: 2em;
  }

  .lesson-nav {
    align-items: center;
    display: grid;
    gap: 1em;
    grid-template-columns: auto 1fr auto;
  }

  .nav-btn {
    background: transparent;
    border: 2px solid var(--accent);
    border-radius: var(--radius);
    color: var(--accent);
    cursor: pointer;
    font-size: 1.1em;
    font-weight: 700;
    padding: 0.45em 0.8em;
    text-decoration: none;
    transition: background var(--transition), color var(--transition);
  }

  .nav-btn:hover {
    background: var(--accent);
    color: #ffffff;
  }

  .nav-btn-placeholder {
    display: block;
  }

  /* Complete button hidden until JS sets correct state to avoid label-width jump */
  .complete-btn {
    background: var(--accent);
    border: 2px solid var(--accent);
    border-radius: var(--radius);
    color: #ffffff;
    cursor: pointer;
    font-family: var(--font);
    font-size: 0.9em;
    font-weight: 700;
    justify-self: center;
    letter-spacing: 0.05em;
    opacity: 0;
    padding: 0.7em 1.5em;
    transition: background var(--transition), color var(--transition);
    white-space: nowrap;
  }

  .complete-btn.ready {
    opacity: 1;
    transition: opacity 0.15s ease, background var(--transition), color var(--transition);
  }

  .complete-btn:hover {
    opacity: 0.82;
  }

  .complete-btn[data-complete] {
    background: transparent;
    color: var(--accent);
  }

  .complete-btn[data-complete]:hover {
    opacity: 0.7;
  }

  /* Label toggling */
  .label-complete {
    display: none;
  }

  .complete-btn[data-complete] .label-incomplete {
    display: none;
  }

  .complete-btn[data-complete] .label-complete {
    display: inline;
  }
</style>
